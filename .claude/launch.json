{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tessera-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--strictPort"],
      "port": 5173
    },
    {
      "name": "tessera-storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook"],
      "port": 6006
    },
    {
      "name": "tessera-docs",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd mintlify && npx --yes mint@4 dev --port 3333"],
      "port": 3333
    },
    {
      "name": "tessera-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--port", "8787"],
      "port": 8787
    }
  ]
}
