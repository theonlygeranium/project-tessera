{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Project Tessera design tokens (phase 1). Source of truth for colors, type, spacing, radii. Human-readable rationale lives in design/DESIGN-NOTES.md. Phase-2 issue #17 generates docs/assets/tokens.css from this file.",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#F4F1EB",
      "$description": "Page ground"
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Cards, panels"
    },
    "surface-alt": {
      "$type": "color",
      "$value": "#FAF8F4",
      "$description": "Rails, headers, footers"
    },
    "surface-sunk": {
      "$type": "color",
      "$value": "#EBE6DD",
      "$description": "Segmented-control track, code background"
    },
    "line": {
      "$type": "color",
      "$value": "#E3DED4",
      "$description": "Borders"
    },
    "line-soft": {
      "$type": "color",
      "$value": "#EDE8DF",
      "$description": "Inner dividers"
    },
    "control-line": {
      "$type": "color",
      "$value": "#D5CFC4",
      "$description": "Button and input borders"
    },
    "ink": {
      "$type": "color",
      "$value": "#1C1B19",
      "$description": "Primary text"
    },
    "ink-2": {
      "$type": "color",
      "$value": "#2A2825",
      "$description": "Reading text"
    },
    "ink-3": {
      "$type": "color",
      "$value": "#3A3833",
      "$description": "Secondary body text"
    },
    "muted": {
      "$type": "color",
      "$value": "#5F5B54",
      "$description": "Secondary/meta text; 6.3:1 on white"
    },
    "accent": {
      "$type": "color",
      "$value": "#0E6B63",
      "$description": "The single brand accent: primary buttons, progress, current item"
    },
    "accent-hover": {
      "$type": "color",
      "$value": "#0A4F49"
    },
    "accent-soft": {
      "$type": "color",
      "$value": "#E3F0EE",
      "$description": "Selected nav, accent tints"
    },
    "ai": {
      "$type": "color",
      "$value": "#5B4BAF",
      "$description": "AI glyph, attribution, footnote numbers. Never a stripe or a meaning-bearing fill."
    },
    "ai-strong": {
      "$type": "color",
      "$value": "#3F3380",
      "$description": "AI label text on tints"
    },
    "ai-soft": {
      "$type": "color",
      "$value": "#EEEBF8"
    },
    "ai-softer": {
      "$type": "color",
      "$value": "#F7F5FC"
    },
    "success": {
      "$type": "color",
      "$value": "#2E7D4F"
    },
    "success-text": {
      "$type": "color",
      "$value": "#1F5A37"
    },
    "success-soft": {
      "$type": "color",
      "$value": "#E4F2E8"
    },
    "warning": {
      "$type": "color",
      "$value": "#9A6A12",
      "$description": "Dots, bars, icons ONLY (4.2:1 on its tint fails as text)"
    },
    "warning-text": {
      "$type": "color",
      "$value": "#7A5310",
      "$description": "Warning text; 6.4:1 on warning-soft"
    },
    "warning-soft": {
      "$type": "color",
      "$value": "#FBF1DC"
    },
    "error": {
      "$type": "color",
      "$value": "#B3382C"
    },
    "error-text": {
      "$type": "color",
      "$value": "#7A2A20"
    },
    "error-soft": {
      "$type": "color",
      "$value": "#FBE7E4"
    },
    "focus": {
      "$type": "color",
      "$value": "#1F4F9C",
      "$description": "Focus ring (3px, 2px offset)"
    },
    "surface-bubble": {
      "$type": "color",
      "$value": "#F0EDE6",
      "$description": "Learner chat bubbles, soft dividers"
    },
    "track": {
      "$type": "color",
      "$value": "#ECE8E0",
      "$description": "Progress-bar and meter tracks"
    },
    "ring-track": {
      "$type": "color",
      "$value": "#E8E3DA",
      "$description": "Weekly time ring track"
    },
    "line-strong": {
      "$type": "color",
      "$value": "#CFC8BB",
      "$description": "Empty/pending state outlines"
    },
    "line-dashed": {
      "$type": "color",
      "$value": "#C9C2B5",
      "$description": "Dashed affordances (add block, ⌘K rail button)"
    },
    "disabled-text": {
      "$type": "color",
      "$value": "#6F6A62",
      "$description": "Disabled or locked option text; 5.2:1 on white"
    },
    "ai-line": {
      "$type": "color",
      "$value": "#D0C8EA",
      "$description": "Borders on AI tints (tutor toggle, chips)"
    }
  },
  "font": {
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "Fraunces",
        "Georgia",
        "serif"
      ],
      "$description": "Titles, lesson reading, and ALL AI text (Marginalia)"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "sans-serif"
      ],
      "$description": "All human UI"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ],
      "$description": "Shortcuts, slash commands, footnote numerals"
    }
  },
  "size": {
    "text-learner": {
      "$type": "dimension",
      "$value": "15px",
      "$description": "Comfortable density base"
    },
    "text-compact": {
      "$type": "dimension",
      "$value": "13.5px",
      "$description": "Instructor/admin base"
    },
    "text-reading": {
      "$type": "dimension",
      "$value": "19px",
      "$description": "Lesson prose; ~68ch measure; line-height 1.6"
    },
    "text-ai": {
      "$type": "dimension",
      "$value": "15.5px",
      "$description": "Marginalia body"
    },
    "text-label": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Uppercase section labels, letter-spacing .06em"
    },
    "title-page": {
      "$type": "dimension",
      "$value": "26px–34px"
    },
    "target-learner": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Minimum touch target on learner surfaces"
    },
    "target-compact": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "Minimum on compact surfaces (WCAG 2.2 floor is 24px)"
    },
    "rail-width": {
      "$type": "dimension",
      "$value": "76px"
    },
    "artboard-desktop": {
      "$type": "dimension",
      "$value": "1440x900"
    },
    "artboard-phone": {
      "$type": "dimension",
      "$value": "390x844"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "7px",
      "$description": "Small buttons, chips in rows"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Buttons, inputs"
    },
    "lg": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Cards"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "ai-style": {
    "default": {
      "$value": "marginalia",
      "$description": "Switchable: marginalia | tabs | perforated | tiles. See docs/assets/ai-voice.css and design/DECISIONS.md D-006."
    }
  },
  "accent-options": {
    "$description": "Institution retint swatches offered by each artboard's accent tweak; the default is color.accent.",
    "teal": {
      "$type": "color",
      "$value": "#0E6B63"
    },
    "blue": {
      "$type": "color",
      "$value": "#1F4F9C"
    },
    "plum": {
      "$type": "color",
      "$value": "#7A3E8F"
    },
    "rust": {
      "$type": "color",
      "$value": "#A24F1F"
    }
  }
}