{
  "name": "project-tessera",
  "private": true,
  "description": "Tooling for the Project Tessera prototype site",
  "scripts": {
    "predev": "node tools/build_tokens.mjs",
    "dev": "vite --config app/vite.config.ts",
    "storybook": "node tools/build_tokens.mjs && storybook dev -c app/.storybook -p 6006 --no-open",
    "build": "node tools/build_tokens.mjs && tsc -p app && npm run build:openapi && vite build --config app/vite.config.ts && storybook build -c app/.storybook -o docs/storybook --quiet",
    "a11y": "npm run build && node tools/a11y_audit.mjs",
    "e2e": "npm run build && node tests/e2e/journeys.mjs",
    "docs:sync": "npm run build && node tools/docs_sync.mjs && node tools/build_mintlify_tokens.mjs",
    "test": "vitest run",
    "build:openapi": "node tools/build_openapi.mjs",
    "typecheck": "tsc -p shared && tsc -p app && tsc -p worker && tsc -p sdk",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.10.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.47.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  }
}
